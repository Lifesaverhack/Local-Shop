rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 60 &&
             data.email is string && data.email.size() >= 5 && data.email.size() <= 120 &&
             data.city is string && data.city.size() >= 2 && data.city.size() <= 60 &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 25)) &&
             (!('avatarUrl' in data) || data.avatarUrl == null || (data.avatarUrl is string && data.avatarUrl.size() <= 5000)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidListing(data) {
      return data.sellerId is string && data.sellerId.size() > 0 && data.sellerId.size() <= 128 &&
             data.sellerName is string && data.sellerName.size() >= 2 && data.sellerName.size() <= 60 &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 120 &&
             data.description is string && data.description.size() >= 5 && data.description.size() <= 3000 &&
             data.priceNpr is number && data.priceNpr >= 0 && data.priceNpr <= 100000000 &&
             data.category is string && data.category.size() >= 2 && data.category.size() <= 60 &&
             data.condition is string && data.condition.size() >= 2 && data.condition.size() <= 40 &&
             data.city is string && data.city.size() >= 2 && data.city.size() <= 60 &&
             (!('locality' in data) || data.locality == null || (data.locality is string && data.locality.size() <= 100)) &&
             (!('photos' in data) || (data.photos is list && data.photos.size() <= 10)) &&
             data.status in ['active', 'sold'] &&
             (!('isFeatured' in data) || data.isFeatured is bool) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidFavorite(data) {
      return data.listingId is string && data.listingId.size() > 0 && data.listingId.size() <= 128 &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    function isValidChatThread(data) {
      return data.listingId is string && data.listingId.size() > 0 && data.listingId.size() <= 128 &&
             data.buyerId is string && data.buyerId.size() > 0 && data.buyerId.size() <= 128 &&
             data.sellerId is string && data.sellerId.size() > 0 && data.sellerId.size() <= 128 &&
             data.participantIds is list && data.participantIds.size() == 2 &&
             (data.buyerId in data.participantIds) && (data.sellerId in data.participantIds) &&
             (!('listingTitle' in data) || (data.listingTitle is string && data.listingTitle.size() <= 120)) &&
             (!('listingPrice' in data) || (data.listingPrice is number && data.listingPrice >= 0)) &&
             (!('buyerName' in data) || (data.buyerName is string && data.buyerName.size() <= 60)) &&
             (!('sellerName' in data) || (data.sellerName is string && data.sellerName.size() <= 60)) &&
             (!('lastMessage' in data) || (data.lastMessage is string && data.lastMessage.size() <= 1000)) &&
             (!('lastMessageTimestamp' in data) || (data.lastMessageTimestamp is timestamp && data.lastMessageTimestamp <= request.time)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidChatMessage(data) {
      return data.chatId is string && data.chatId.size() > 0 && data.chatId.size() <= 128 &&
             data.senderId is string && data.senderId.size() > 0 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 2000 &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    function isValidReport(data) {
      return data.listingId is string && data.listingId.size() > 0 && data.listingId.size() <= 128 &&
             data.reporterId is string && data.reporterId.size() > 0 && data.reporterId.size() <= 128 &&
             data.reason is string && data.reason.size() >= 2 && data.reason.size() <= 100 &&
             (!('details' in data) || data.details == null || (data.details is string && data.details.size() <= 1000)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'city', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       isValidUserProfile(incoming());
      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'city', 'phone', 'avatarUrl', 'updatedAt']);
      allow delete: if isSignedIn() && request.auth.uid == userId;

      // Subcollection: User Favorites
      match /favorites/{listingId} {
        allow get, list: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         incoming().listingId == listingId &&
                         incoming().createdAt is timestamp &&
                         isValidFavorite(incoming());
        allow delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // --- Listings Collection ---
    match /listings/{listingId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() &&
                       incoming().sellerId == request.auth.uid &&
                       incoming().keys().hasAll(['sellerId', 'sellerName', 'title', 'description', 'priceNpr', 'category', 'condition', 'city', 'status', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       isValidListing(incoming());
      allow update: if isSignedIn() &&
                       existing().sellerId == request.auth.uid &&
                       incoming().sellerId == existing().sellerId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidListing(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'description', 'priceNpr', 'category', 'condition', 'city',
                         'locality', 'photos', 'status', 'isFeatured', 'updatedAt'
                       ]);
      allow delete: if isSignedIn() && existing().sellerId == request.auth.uid;
    }

    // --- Chats Collection ---
    match /chats/{chatId} {
      allow get, list: if isSignedIn() && (request.auth.uid in existing().participantIds);
      allow create: if isSignedIn() &&
                       (request.auth.uid in incoming().participantIds) &&
                       incoming().keys().hasAll(['listingId', 'buyerId', 'sellerId', 'participantIds', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       isValidChatThread(incoming());
      allow update: if isSignedIn() &&
                       (request.auth.uid in existing().participantIds) &&
                       incoming().buyerId == existing().buyerId &&
                       incoming().sellerId == existing().sellerId &&
                       incoming().participantIds == existing().participantIds &&
                       incoming().listingId == existing().listingId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidChatThread(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastMessageTimestamp', 'updatedAt']);
      allow delete: if false;

      // Messages Subcollection
      match /messages/{messageId} {
        allow get, list: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds);
        allow create: if isSignedIn() &&
                         (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds) &&
                         incoming().senderId == request.auth.uid &&
                         incoming().keys().hasAll(['chatId', 'senderId', 'senderName', 'text', 'createdAt']) &&
                         incoming().createdAt is timestamp &&
                         isValidChatMessage(incoming());
        allow update, delete: if false;
      }
    }

    // --- Reports Collection ---
    match /reports/{reportId} {
      allow create: if isSignedIn() &&
                       incoming().reporterId == request.auth.uid &&
                       incoming().keys().hasAll(['listingId', 'reporterId', 'reason', 'createdAt']) &&
                       incoming().createdAt is timestamp &&
                       isValidReport(incoming());
      allow read, update, delete: if false;
    }
  }
}
